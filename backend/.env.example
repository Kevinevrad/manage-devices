# Copier ce fichier en .env puis adapter les valeurs

# Connexion à la base SQLite (chemin relatif à la racine du backend)
DATABASE_URL="file:./prisma/manage_devices.db"

# Port d'écoute de l'API
PORT=3000

# Secret de signature des JWT — générer une valeur forte en production
# (ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="changez-moi-en-production"

# Durée de validité des jetons de session
JWT_EXPIRE_IN="7d"