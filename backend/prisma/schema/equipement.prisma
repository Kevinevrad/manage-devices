enum StatutEquipement {
    Non_Affecte
    En_service
    En_stock
    En_panne
    Rebut
}

model Equipement {

    id  Int @id @default(autoincrement())
    nom String
    type String 
    marque String
    prix Float  // Prix d'achat en euros
    numSerie String @unique
    statut StatutEquipement @default(Non_Affecte) // Libellés API : "Non Affecté", "En service", "En stock", "En panne", "Rebut"
    dateAchat DateTime @default(now())


    userId Int?
    utilisateur User? @relation(fields: [userId], references: [id])


    logiciels     LicencesSurEquipement[]
    historiquesAffectations Affectation[]

    organisationId Int?
    organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
}