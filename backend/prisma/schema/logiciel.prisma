model Logiciel {

    id Int @id @default(autoincrement())
    nom String  // Ex: "Office 365", "Adobe CC", "Windows 11 Pro",
    editeur String 
    cleLicence String @unique
    dateAchat DateTime @default(now())
    dateExp DateTime? // Null pour une licence perpétuelle
    typeLicence String @default("Abonnement") // "Abonnement", "Perpétuelle"
    siegesTotal Int?    // Nombre de postes couverts par la licence
    coutAnnuel Float?   // Coût annuel en euros (null pour une licence perpétuelle)
    
    // Relation : Un logiciel peut être installé sur plusieurs équipements (et inversement)
    affectations LicencesSurEquipement[]

}
