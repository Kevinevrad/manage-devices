
enum Role {
    user
    admin
    technicien
}

model User {
    id        Int     @id @default(autoincrement())
    nom       String
    prenom    String
    email     String  @unique
    motDePasse String // Hash bcrypt — jamais renvoyé par l'API
    structure String
    service   String
    role      Role    @default(user) // "user", "admin", "technicien"

    equipements Equipement[]
    historiquesAffectations Affectation[]

    organisationId Int?
    organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
}