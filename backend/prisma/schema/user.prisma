
model User {
    id        Int     @id @default(autoincrement())
    nom       String
    prenom    String
    email     String  @unique
    motDePasse String // Hash bcrypt — jamais renvoyé par l'API
    structure String
    service   String
    role      String  @default("user") // "user", "admin", "technicien"

    equipements Equipement[]
    historiquesAffectations Affectation[]
}